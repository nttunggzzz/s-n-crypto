# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
# Local: `npm run db:start` (embedded PostgreSQL on :5433). Staging/prod: Railway PostgreSQL URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cex
APP_URL=http://localhost:5173
# Extra web app origins allowed (admin, signals), comma separated
CORS_ORIGINS=http://localhost:5174,http://localhost:5175
# binance (real prices) | sim (synthetic prices on real pair rules — dev/e2e/CI, refused in production) | off
MARKET_FEED=binance
# true = a new account must verify its email before using the faucet / trading. Dev has no mail server (emails only go to the
# server log), so `npm run dev` runs with false unless this is set here or you pass --verify-email. Production: true + EMAIL_TRANSPORT=resend.
REQUIRE_EMAIL_VERIFICATION=false
# Cloudflare Turnstile (captcha) — set BOTH or neither; empty disables captcha (dev only)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# open | invite (sign-up needs an invite code: `npm run admin:invite -- "<who>"`). Default: invite in production, open otherwise.
REGISTRATION=
# log (dev: links printed in server log) | resend
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=CEX Sim <no-reply@example.com>
# 32 random bytes, base64 — encrypts 2FA secrets. REQUIRED in production; dev/test use a fixed key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
TOTP_ISSUER=CEX Sim
LOG_LEVEL=info
# Production build of apps/exchange served at / on this same origin (the Docker image sets it). Empty = API only.
WEB_DIST=
# Production build of apps/admin served at /admin/ (same origin = same sign-in; the Docker image sets it).
ADMIN_WEB_DIST=
# Operator alerts (feed down > 2 min, ledger mismatch, crash, start-up) — set both or neither; empty = log only.
# Test: npm run alert:test -w @cex/server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ENV_NAME=
