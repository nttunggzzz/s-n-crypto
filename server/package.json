{
  "name": "@cex/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsx scripts/build.ts",
    "db:start": "tsx scripts/devDb.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "admin:set-role": "tsx --env-file-if-exists=../.env scripts/setRole.ts",
    "admin:invite": "tsx --env-file-if-exists=../.env scripts/createInvite.ts",
    "sim:snapshot": "tsx scripts/simSnapshot.ts",
    "restore:check": "tsx scripts/restoreCheck.ts",
    "alert:test": "tsx --env-file-if-exists=../.env scripts/testAlert.ts"
  },
  "dependencies": {
    "@cex/contracts": "*",
    "@cex/core": "*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "embedded-postgres": "^17.5.0-beta.15",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.0.0"
  }
}
