{
  "name": "cex-sim",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev": "node infra/dev.mjs",
    "dev:server": "npm run dev -w @cex/server",
    "db:start": "npm run db:start -w @cex/server",
    "db:generate": "npm run db:generate -w @cex/server",
    "db:migrate": "npm run db:migrate -w @cex/server",
    "typecheck": "node infra/typecheck-all.mjs",
    "test": "node infra/test-all.mjs",
    "test:watch": "vitest",
    "verify": "node infra/verify.mjs",
    "e2e": "node infra/e2e.mjs",
    "lint": "eslint .",
    "ui-coverage": "node infra/ui-coverage.mjs",
    "host": "node infra/host.mjs",
    "ui-check": "node infra/ui-check.mjs",
    "admin:set-role": "npm run admin:set-role -w @cex/server --",
    "admin:invite": "npm run admin:invite -w @cex/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.14.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
