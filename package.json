{
  "name": "cex-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev": "node infra/dev.mjs",
    "dev:server": "npm run dev -w @cex/server",
    "db:start": "npm run db:start -w @cex/server",
    "db:generate": "npm run db:generate -w @cex/server",
    "db:migrate": "npm run db:migrate -w @cex/server",
    "typecheck": "node infra/typecheck-all.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node infra/verify.mjs",
    "admin:set-role": "npm run admin:set-role -w @cex/server --"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
